// Dev container for VS Code, RubyMine, Codespaces and the devcontainer CLI. It opens the `web` container of the
// same stack `make up` starts. See "Docker development environment" in AGENTS.md.
{
  "name": "Cuttlefish",
  "dockerComposeFile": "../compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  // Waits for the app to finish starting, so the first command you run works. Gives up after START_LIMIT (compose.yaml).
  "postStartCommand": ["sh", ".devcontainer/wait-for-app.sh", "web", "the database and Rails", "curl", "-fs", "-o", "/dev/null", "http://localhost:3000/"],
  "customizations": {
    "vscode": {
      "extensions": ["shopify.ruby-lsp"]
    }
  }
}
